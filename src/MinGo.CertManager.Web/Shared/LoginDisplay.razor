@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>
        <div class="relative" @ref="containerRef">
            <button class="flex items-center space-x-2 p-2 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors" @onclick="ToggleUserMenu">
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-medium">
                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <span class="hidden sm:block text-sm font-medium">
                    @context.User.Identity?.Name
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            @if (isUserMenuOpen)
            {
                <div class="absolute right-0 mt-2 w-48 card shadow-lg z-50" @onclick:stopPropagation>
                    <div class="py-1">
                        <div class="px-4 py-2 border-b border-border">
                            <p class="text-sm font-medium">@context.User.Identity?.Name</p>
                            <p class="text-xs text-muted-foreground">@UserRole</p>
                        </div>
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-accent transition-colors" @onclick="NavigateToProfile">
                            个人设置
                        </button>
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-accent transition-colors" @onclick="NavigateToUsers">
                            用户管理
                        </button>
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-accent transition-colors" @onclick="NavigateToApiKeys">
                            API Key管理
                        </button>
                        <button class="w-full text-left px-4 py-2 text-sm text-destructive hover:bg-accent transition-colors" @onclick="Logout">
                            退出登录
                        </button>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="login" class="text-sm text-white hover:text-gray-300">登录</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ElementReference containerRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<LoginDisplay>? dotNetRef;
    private ApplicationUser? user;
    private bool isUserMenuOpen = false;
    private string UserRole => GetUserRole();

    private string GetUserRole()
    {
        var authState = Task.Run(async () => await AuthenticationStateProvider.GetAuthenticationStateAsync()).Result;
        var principal = authState.User;
        
        if (principal.IsInRole("Admin"))
        {
            return "管理员";
        }
        return "用户";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            user = await UserManager.GetUserAsync(principal);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/LoginDisplay.razor.js");
            dotNetRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("initLoginDisplay", containerRef, dotNetRef, nameof(CloseUserMenu));
        }
    }

    [JSInvokable]
    public void CloseUserMenu()
    {
        if (isUserMenuOpen)
        {
            isUserMenuOpen = false;
            StateHasChanged();
        }
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("Logout", forceLoad: true);
    }

    private void NavigateToApiKeys()
    {
        NavigationManager.NavigateTo("api-keys");
        isUserMenuOpen = false;
    }

    private void NavigateToUsers()
    {
        NavigationManager.NavigateTo("users");
        isUserMenuOpen = false;
    }
    
    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("profile");
        isUserMenuOpen = false;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module != null)
        {
            await module.InvokeVoidAsync("cleanupLoginDisplay");
            await module.DisposeAsync();
        }
        dotNetRef?.Dispose();
    }
}
