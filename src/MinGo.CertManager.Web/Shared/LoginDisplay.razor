@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>
        <div class="relative" @ref="containerRef">
            <button id="login-display-button" class="flex items-center space-x-2 focus:outline-none">
                <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-white">
                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <span class="text-sm">
                    @context.User.Identity?.Name
                </span>
                <span class="text-xs">▼</span>
            </button>

            <div id="login-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden">
                <a href="/api-keys" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                    API Key管理
                </a>
                <form method="post" action="Account/Logout" class="block">
                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        退出登录
                    </button>
                </form>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="login" class="text-sm text-white hover:text-gray-300">登录</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ElementReference containerRef;
    private IJSObjectReference? module;
    private ApplicationUser? user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            user = await UserManager.GetUserAsync(principal);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/LoginDisplay.razor.js");
            await module.InvokeVoidAsync("initLoginDisplay", containerRef, null, null);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module != null)
        {
            await module.InvokeVoidAsync("cleanupLoginDisplay");
            await module.DisposeAsync();
        }
    }
}
