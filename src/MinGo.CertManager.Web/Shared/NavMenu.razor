<div class="top-row ps-3 bg-gray-800 text-white">
    <div class="container mx-auto flex justify-between items-center">
        <a class="text-xl font-bold" href="">MinGo.CertManager</a>
        <div class="flex items-center space-x-4">
            <LoginDisplay />
            <button title="Navigation menu" class="p-2" @onclick="ToggleNavMenu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                </svg>
            </button>
        </div>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column bg-gray-800 text-white">
        <div class="p-3">
            <NavLink class="block px-3 py-2 rounded-md hover:bg-gray-700" href="certificates" Match="NavLinkMatch.Prefix">
                <span class="mr-2"></span> 证书管理
            </NavLink>
            <AuthorizeView Roles="Admin">
                <NavLink class="block px-3 py-2 rounded-md hover:bg-gray-700 mt-2" href="users" Match="NavLinkMatch.Prefix">
                    <span class="mr-2"></span> 用户管理
                </NavLink>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
