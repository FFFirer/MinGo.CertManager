{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "OpenTelemetry"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=certmanager.db"
  },
  "Acme": {
    "UseStaging": false,
    "AccountEmail": "",
    "LetsEncryptProductionUrl": "https://acme-v02.api.letsencrypt.org/directory",
    "LetsEncryptStagingUrl": "https://acme-staging-v02.api.letsencrypt.org/directory"
  },
  "Certificate": {
    "ValidityDays": 90,
    "RenewalDaysBeforeExpiry": 30
  },
  "AliyunDns": {
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "RegionId": "cn-hangzhou",
    "ApiVersion": "2015-01-09",
    "Endpoint": "https://alidns.aliyuncs.com/"
  },
  "Quartz": {
    "SchedulerName": "MinGo CertManager Scheduler",
    "SchedulerInstanceId": "MinGo-CertManager-Scheduler"
  },
  "QuartzAgent": {
    "Enabled": false,
    "ApiPrefix": "/api/agent"
  },
  "Agent": {
    "HeartbeatIntervalSeconds": 30,
    "ExternalUrl": ""
  },
  "Platform": {
    "Url": "",
    "ApiToken": ""
  },
  "OAuthProviders": {
    "EnabledProviders": [],
    "Providers": {
      "github": {
        "ClientId": "",
        "ClientSecret": "",
        "CallbackPath": "/signin-github",
        "Scopes": [
          "user:email"
        ]
      },
      "simpleidserver": {
        "DisplayName": "1MinGo",
        "ClientId": "",
        "ClientSecret": "",
        "Authority": "",
        "Realm": "master",
        "CallbackPath": "/signin-simpleidserver",
        "Scopes": [
          "openid",
          "profile"
        ]
      }
    }
  },
  "ForwardedHeaders": {
    "Enabled": true
  },
  "OpenTelemetry": {
    "ServiceName": "MinGo.CertManager",
    "OtlpEndpoint": "http://localhost:4317",
    "OtlpProtocol": "grpc",
    "EnableOtlpExporter": true,
    "EnablePrometheusExporter": false
  },
  "ApiKeys": {
    "Keys": [
      {
        "Name": "默认API Key",
        "Key": "default-api-key",
        "Secret": "default-api-secret",
        "CreatedAt": "2026-03-04T00:00:00Z"
      }
    ]
  },
  "Messaging": {
    "Enabled": false,
    "Integrations": {
      "SimpleMessageBroker": {
        "Type": "SimpleMessageBroker",
        "BaseAddress": "http://localhost:5100",
        "ApiKey": "",
        "PollingInterval": "00:00:01",
        "BatchSize": 10,
        "ConsumeTimeoutSeconds": 5
      }
    },
    "Publishers": {
      "CertBus": {
        "Integration": "SimpleMessageBroker"
      }
    }
  }
}
