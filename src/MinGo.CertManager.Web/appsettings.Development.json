{
  "DetailedErrors": true,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Messaging": {
    "Enabled": true
  },
  "Vite": {
    "Server": {
      "Host": "localhost",
      "Port": 5174,
      "PackageManager": "pnpm",
      "AutoRun": true
    }
  },
  "OAuthProviders": {
    "EnabledProviders": [
      "simpleidserver",
      "github"
    ]
  }
}
