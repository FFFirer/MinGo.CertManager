{
  "DetailedErrors": true,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Messaging": {
    "Enabled": false
  },
  "QuartzAgent": {
    "Enabled": true
  },
  "Platform": {
    "Url": "http://localhost:5000",
    "ApiToken": "x"
  },
  "Agent": {
    "ExternalUrl": "http://localhost:5042"
  },
  "Quartz": {
    "AssemblyPaths": [
      "MinGo.CertManager.Integration"
    ]
  },
  "Vite": {
    "Server": {
      "Host": "localhost",
      "Port": 5174,
      "PackageManager": "pnpm",
      "AutoRun": true
    }
  },
  "OAuthProviders": {
    "EnabledProviders": [
      "simpleidserver",
      "github"
    ]
  }
}
