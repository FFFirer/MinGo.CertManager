{
  "DetailedErrors": true,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Vite": {
    "Server": {
      "Host": "localhost",
      "Port": 5173,
      "PackageManager": "pnpm",
      "AutoRun": true
    }
  }
}
