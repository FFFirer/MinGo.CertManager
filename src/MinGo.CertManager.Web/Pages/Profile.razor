@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using MinGo.CertManager.Core.Services
@using MinGo.CertManager.Infrastructure.Data
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageHeader
    Title="个人设置"
    Description="管理个人账号信息">
</PageHeader>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1">
        <div class="card">
            <div class="p-6">
                <div class="flex flex-col items-center">
                    <div class="w-24 h-24 rounded-full bg-primary flex items-center justify-center text-white text-3xl font-bold mb-4">
                        @(currentUser?.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <h2 class="text-xl font-semibold">@currentUser?.Identity?.Name</h2>
                    <p class="text-muted-foreground">@UserRole</p>
                </div>
                
                <div class="mt-6 space-y-2">
                    <button class="w-full text-left px-4 py-3 rounded-md bg-accent text-accent-foreground font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        个人信息
                    </button>
                    <button class="w-full text-left px-4 py-3 rounded-md hover:bg-accent hover:text-accent-foreground font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        安全设置
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="lg:col-span-2">
        <div class="card">
            <div class="p-6">
                <h3 class="text-lg font-semibold mb-4">修改密码</h3>
                
                <EditForm Model="passwordModel" OnValidSubmit="HandleChangePassword">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <div>
                            <label class="label">当前密码</label>
                            <InputText type="password" class="input" @bind-Value="passwordModel.CurrentPassword" placeholder="请输入当前密码" />
                            <ValidationMessage For="() => passwordModel.CurrentPassword" class="text-red-500 text-sm" />
                        </div>
                        
                        <div>
                            <label class="label">新密码</label>
                            <InputText type="password" class="input" @bind-Value="passwordModel.NewPassword" placeholder="请输入新密码" />
                            <ValidationMessage For="() => passwordModel.NewPassword" class="text-red-500 text-sm" />
                        </div>
                        
                        <div>
                            <label class="label">确认新密码</label>
                            <InputText type="password" class="input" @bind-Value="passwordModel.ConfirmPassword" placeholder="请再次输入新密码" />
                            <ValidationMessage For="() => passwordModel.ConfirmPassword" class="text-red-500 text-sm" />
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Message))
                        {
                            <div class="p-3 rounded-md @(IsSuccess ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                @Message
                            </div>
                        }
                        
                        <div class="flex justify-end">
                            <button type="submit" class="btn btn-primary">保存修改</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        @* 第三方账号管理 *@
        <div class="card mt-6">
            <div class="p-6">
                <h3 class="text-lg font-semibold mb-4">第三方账号</h3>

                @if (!string.IsNullOrEmpty(linkMessage))
                {
                    <div class="p-3 rounded-md mb-4 @(linkIsSuccess ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                        @linkMessage
                    </div>
                }

                @if (currentLogins.Count > 0)
                {
                    <div class="space-y-3">
                        @foreach (var login in currentLogins)
                        {
                            <div class="flex items-center justify-between py-3 border-b last:border-b-0">
                                <div class="flex items-center gap-3">
                                    <i class="@GetProviderIcon(login.LoginProvider) text-xl w-6 text-center"></i>
                                    <div>
                                        <div class="font-medium">@login.ProviderDisplayName</div>
                                        <div class="text-sm text-muted-foreground">@login.ProviderKey</div>
                                    </div>
                                </div>
                                @if (showUnbindConfirm && unbindProvider == login.LoginProvider && unbindProviderKey == login.ProviderKey)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm text-muted-foreground">确认解除？</span>
                                        <button class="btn btn-ghost btn-sm text-green-600" @onclick="() => ConfirmUnbind()">确认</button>
                                        <button class="btn btn-ghost btn-sm" @onclick="() => CancelUnbind()">取消</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm text-red-500"
                                            @onclick="() => PromptUnbind(login.LoginProvider, login.ProviderKey)"
                                            disabled="@(!CanUnbind)">
                                        @(CanUnbind ? "解除绑定" : "不可解除")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted-foreground py-3">尚未绑定第三方账号</p>
                }

                @* 绑定新账号 *@
                @{
                    var availableProviders = GetAvailableProviders();
                }
                @if (availableProviders.Count > 0)
                {
                    <div class="mt-4 pt-4 border-t border-border">
                        <p class="text-sm text-muted-foreground mb-3">绑定第三方账号</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var provider in availableProviders)
                            {
                                <button class="btn btn-outline btn-sm flex items-center gap-2"
                                        @onclick="() => StartLinkLogin(provider.ProviderName)">
                                    <i class="@provider.IconCssClass"></i>
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private UserManager<ApplicationUser> UserManager { get; set; } = null!;
    
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;
    
    [Inject]
    private SignInManager<ApplicationUser> SignInManager { get; set; } = null!;

    [Inject]
    private IEnumerable<IOAuthLoginProvider> OAuthProviders { get; set; } = null!;
    
    private ClaimsPrincipal currentUser = null!;
    private PasswordModel passwordModel = new();
    private string Message = string.Empty;
    private bool IsSuccess = false;
    
    // 外部账号管理
    private List<UserLoginInfo> currentLogins = new();
    private Dictionary<string, string> providerIconMap = new();
    private bool hasPassword;
    private string unbindProvider = string.Empty;
    private string unbindProviderKey = string.Empty;
    private bool showUnbindConfirm = false;
    private string linkMessage = string.Empty;
    private bool linkIsSuccess;
    
    private string UserRole => GetUserRole();
    
    private bool CanUnbind => hasPassword || currentLogins.Count > 1;
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        await LoadExternalLoginsAsync();
    }
    
    private string GetUserRole()
    {
        if (currentUser?.IsInRole("Admin") == true)
        {
            return "管理员";
        }
        return "用户";
    }
    
    private async Task LoadExternalLoginsAsync()
    {
        var user = await UserManager.GetUserAsync(currentUser);
        if (user == null) return;

        // 构建 Provider 名称 → 图标映射
        providerIconMap = OAuthProviders.ToDictionary(p => p.ProviderName, p => p.IconCssClass);

        // 获取已绑定的外部账号
        currentLogins = (await UserManager.GetLoginsAsync(user)).ToList();

        // 检查用户是否有密码
        hasPassword = await UserManager.HasPasswordAsync(user);
    }

    private string GetProviderIcon(string providerName)
    {
        return providerIconMap.TryGetValue(providerName, out var icon) ? icon : "fas fa-key";
    }

    private void StartLinkLogin(string provider)
    {
        NavigationManager.NavigateTo($"/ExternalLogin?handler=LinkLogin&provider={provider}&returnUrl=/profile");
    }

    private List<IOAuthLoginProvider> GetAvailableProviders()
    {
        var boundProviders = new HashSet<string>(currentLogins.Select(l => l.LoginProvider));
        return OAuthProviders
            .Where(p => !boundProviders.Contains(p.ProviderName))
            .ToList();
    }

    private void PromptUnbind(string provider, string providerKey)
    {
        unbindProvider = provider;
        unbindProviderKey = providerKey;
        showUnbindConfirm = true;
    }

    private void CancelUnbind()
    {
        unbindProvider = string.Empty;
        unbindProviderKey = string.Empty;
        showUnbindConfirm = false;
    }

    private async Task ConfirmUnbind()
    {
        var user = await UserManager.GetUserAsync(currentUser);
        if (user == null) return;

        var result = await UserManager.RemoveLoginAsync(user, unbindProvider, unbindProviderKey);
        if (result.Succeeded)
        {
            await SignInManager.RefreshSignInAsync(user);
            linkMessage = $"已解除 {unbindProvider} 的绑定";
            linkIsSuccess = true;
        }
        else
        {
            linkMessage = "解除绑定失败：" + string.Join(", ", result.Errors.Select(e => e.Description));
            linkIsSuccess = false;
        }

        CancelUnbind();
        await LoadExternalLoginsAsync();
    }
    
    private async Task HandleChangePassword()
    {
        if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
        {
            Message = "新密码和确认密码不一致";
            IsSuccess = false;
            return;
        }
        
        var user = await UserManager.GetUserAsync(currentUser);
        if (user == null)
        {
            Message = "用户不存在";
            IsSuccess = false;
            return;
        }
        
        var result = await UserManager.ChangePasswordAsync(user, passwordModel.CurrentPassword, passwordModel.NewPassword);
        if (result.Succeeded)
        {
            Message = "密码修改成功";
            IsSuccess = true;
            passwordModel = new();
        }
        else
        {
            Message = string.Join("\n", result.Errors.Select(e => e.Description));
            IsSuccess = false;
        }
    }
    
    private class PasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}