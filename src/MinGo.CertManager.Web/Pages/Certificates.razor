@page "/certificates"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MinGo.CertManager.Core.Entities
@using MinGo.CertManager.Infrastructure.Repositories
@using MinGo.CertManager.Core.Services
@inject ICertificateRepository CertificateRepository
@inject ICertificateService CertificateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageHeader 
    Title="证书列表"
    Description="查看和管理您的SSL证书">
    <Actions>
        <button class="btn btn-primary" @onclick="NavigateToApply">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            申请证书
        </button>
    </Actions>
</PageHeader>

<div class="card">
    <div class="p-6 border-b border-border">
        <div class="flex flex-col sm:flex-row gap-4">
            <select class="select w-full sm:w-48" @onchange="OnFilterStatusChange">
                <option value="">全部状态</option>
                <option value="Pending" selected="@(filterStatus == CertificateStatus.Pending)">待处理</option>
                <option value="Active" selected="@(filterStatus == CertificateStatus.Active)">有效</option>
                <option value="Expiring" selected="@(filterStatus == CertificateStatus.Expiring)">即将过期</option>
                <option value="Expired" selected="@(filterStatus == CertificateStatus.Expired)">已过期</option>
                <option value="Failed" selected="@(filterStatus == CertificateStatus.Failed)">失败</option>
            </select>
            <input type="text" class="input flex-1" placeholder="搜索域名" @bind="searchDomain" @oninput="OnSearchDomainChange" />
        </div>
    </div>

    @if (certificates == null || certificates.Count == 0)
    {
        <div class="text-center py-12 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-muted-foreground mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p>暂无证书</p>
        </div>
    }
    else
    {
        <div class="divide-y divide-border">
            @foreach (var cert in certificates)
            {
                <div class="certificate-row">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <h3 class="font-semibold text-lg">@cert.Domain</h3>
                                <div class="flex items-center gap-2 mt-1">
                                    @if (cert.IsWildcard)
                                    {
                                        <span class="badge badge-info">泛域名</span>
                                    }
                                    <span class="badge @GetStatusBadgeClass((CertificateStatus)cert.Status)">@GetStatusText((CertificateStatus)cert.Status)</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 grid grid-cols-1 sm:grid-cols-4 gap-4 text-sm">
                            <div>
                                <span class="text-muted-foreground">申请时间:</span>
                                <span class="ml-2">@cert.IssuedAt.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div>
                                <span class="text-muted-foreground">过期时间:</span>
                                <span class="ml-2 @GetExpiryClass(cert.ExpiresAt)">@cert.ExpiresAt.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div>
                                <span class="text-muted-foreground">ACME环境:</span>
                                <span class="ml-2">@(cert.UseStaging ? "测试环境" : "生产环境")</span>
                            </div>
                            <div>
                                <span class="text-muted-foreground">ACME状态:</span>
                                <span class="ml-2">@GetAcmeStatusText((AcmeProcessStatus)cert.AcmeStatus)</span>
                                @if (!string.IsNullOrEmpty(cert.AcmeStatusMessage))
                                {
                                    <div class="ml-2 text-xs text-muted-foreground">@cert.AcmeStatusMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 ml-4">
                        @if (cert.Status == CertificateStatus.Active || cert.Status == CertificateStatus.Expiring || cert.Status == CertificateStatus.Expired)
                        {
                            <button class="btn btn-primary" @onclick="@(() => ShowExportDialog(cert))">导出</button>
                        }
                        @if (cert.Status == CertificateStatus.Active)
                        {
                            <button class="btn btn-secondary" @onclick="@(() => RenewCertificate(cert.Id))">续签</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<ExportModal IsVisible="@showExportModal" Certificate="@selectedCertificate" OnClose="HideExportDialog" OnExport="HandleExport" />

@code {
    private List<Certificate> certificates = new();
    private CertificateStatus? filterStatus;
    private string searchDomain = string.Empty;
    private bool showExportModal = false;
    private Certificate? selectedCertificate;

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificates();
    }

    private string GetStatusText(CertificateStatus status)
    {
        return status switch
        {
            CertificateStatus.Active => "有效",
            CertificateStatus.Pending => "待处理",
            CertificateStatus.Expiring => "即将过期",
            CertificateStatus.Expired => "已过期",
            CertificateStatus.Failed => "失败",
            _ => "未知"
        };
    }

    private string GetStatusBadgeClass(CertificateStatus status)
    {
        return status switch
        {
            CertificateStatus.Active => "badge-success",
            CertificateStatus.Pending => "badge-warning",
            CertificateStatus.Expiring => "badge-error",
            CertificateStatus.Expired => "badge-error",
            CertificateStatus.Failed => "badge-error",
            _ => "badge-info"
        };
    }

    private string GetExpiryClass(DateTime expiryDate)
    {
        var daysRemaining = (expiryDate - DateTime.UtcNow).Days;
        return daysRemaining switch
        {
            <= 0 => "text-destructive",
            <= 30 => "text-yellow-600 dark:text-yellow-400",
            _ => "text-foreground"
        };
    }

    private string GetAcmeStatusText(AcmeProcessStatus status)
    {
        return status switch
        {
            AcmeProcessStatus.Initializing => "初始化",
            AcmeProcessStatus.CreatingAccount => "创建账户",
            AcmeProcessStatus.CreatingOrder => "创建订单",
            AcmeProcessStatus.ProcessingAuthorization => "处理授权",
            AcmeProcessStatus.CreatingDnsRecord => "创建DNS记录",
            AcmeProcessStatus.WaitingDnsPropagation => "等待DNS传播",
            AcmeProcessStatus.ValidatingChallenge => "验证挑战",
            AcmeProcessStatus.GeneratingCertificate => "生成证书",
            AcmeProcessStatus.Completed => "已完成",
            AcmeProcessStatus.Failed => "失败",
            _ => "未知"
        };
    }

    private async Task LoadCertificates()
    {
        if (!string.IsNullOrEmpty(searchDomain))
        {
            certificates = await CertificateRepository.SearchByDomainAsync(searchDomain);
        }
        else if (filterStatus.HasValue)
        {
            certificates = await CertificateRepository.GetByStatusAsync(filterStatus.Value);
        }
        else
        {
            certificates = await CertificateRepository.GetAllAsync();
        }
    }

    private void OnFilterStatusChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        filterStatus = value switch
        {
            "Pending" => CertificateStatus.Pending,
            "Active" => CertificateStatus.Active,
            "Expiring" => CertificateStatus.Expiring,
            "Expired" => CertificateStatus.Expired,
            "Failed" => CertificateStatus.Failed,
            _ => null
        };
        _ = LoadCertificates();
    }

    private void OnSearchDomainChange(ChangeEventArgs e)
    {
        searchDomain = e.Value?.ToString() ?? string.Empty;
        _ = LoadCertificates();
    }

    private void NavigateToApply()
    {
        NavigationManager.NavigateTo("/certificates/apply");
    }

    private void ShowExportDialog(Certificate certificate)
    {
        selectedCertificate = certificate;
        showExportModal = true;
    }

    private void HideExportDialog()
    {
        showExportModal = false;
        selectedCertificate = null;
    }

    private async Task HandleExport((Certificate Certificate, string Format, string? Password) args)
    {
        var (certificate, format, password) = args;
        try
        {
            var certFormat = format switch
            {
                "Pfx" => CertificateFormat.Pfx,
                "Pem" => CertificateFormat.Pem,
                "Crt" => CertificateFormat.Crt,
                _ => CertificateFormat.Pfx
            };

            var url = $"/api/certificates/download/{certificate.Id}?format={certFormat}";
            if (!string.IsNullOrEmpty(password))
            {
                url += $"&password={Uri.EscapeDataString(password)}";
            }

            var fileExtension = certFormat == CertificateFormat.Crt ? "zip" : certFormat.ToString().ToLower();
            var fileName = $"{certificate.Domain}.{fileExtension}";
            await JS.InvokeVoidAsync("downloadFile", new object[] { url, fileName });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task RenewCertificate(Guid certificateId)
    {
        try
        {
            await CertificateService.RenewCertificateAsync(certificateId);
            await LoadCertificates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}