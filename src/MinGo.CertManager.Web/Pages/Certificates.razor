@page "/certificates"
@using MinGo.CertManager.Core.Entities
@using MinGo.CertManager.Infrastructure.Repositories
@using MinGo.CertManager.Infrastructure.Services
@inject ICertificateRepository CertificateRepository
@inject ICertificateService CertificateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>证书管理</PageTitle>

<div class="container mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-foreground mb-2">证书管理</h1>
        <p class="text-muted-foreground">管理和导出您的SSL证书</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="lg:col-span-1">
            <div class="card">
                <h2 class="text-lg font-semibold mb-4">申请新证书</h2>
                <EditForm Model="@newCertificateModel" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="mb-4 text-destructive" />

                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-2">域名</label>
                        <InputText class="w-full px-3 py-2 rounded-md border border-input focus:outline-none focus:ring-2 focus:ring-ring bg-background text-foreground" @bind-Value="newCertificateModel.Domain" placeholder="example.com" />
                        <ValidationMessage For="@(() => newCertificateModel.Domain)" class="text-destructive text-sm mt-1" />
                    </div>

                    <div class="mb-4">
                        <div class="flex items-center">
                            <InputCheckbox class="w-4 h-4 rounded border-input focus:ring-2 focus:ring-ring" @bind-Value="newCertificateModel.IsWildcard" />
                            <label class="ml-2 text-sm">泛域名 (*.domain.com)</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="flex items-center">
                            <InputCheckbox class="w-4 h-4 rounded border-input focus:ring-2 focus:ring-ring" @bind-Value="useStaging" />
                            <label class="ml-2 text-sm">使用Let's Encrypt测试环境</label>
                        </div>
                    </div>

                    <button type="submit" class="w-full btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>申请中...</span>
                        }
                        else
                        {
                            <span>申请证书</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="card">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
                    <h2 class="text-lg font-semibold">证书列表</h2>
                    <div class="flex gap-2 w-full sm:w-auto">
                        <InputSelect class="px-3 py-2 rounded-md border border-input focus:outline-none focus:ring-2 focus:ring-ring bg-background text-foreground" @bind-Value="filterStatus" @onchange="LoadCertificates">
                            <option value="">全部状态</option>
                            <option value="Pending">待处理</option>
                            <option value="Active">有效</option>
                            <option value="Expiring">即将过期</option>
                            <option value="Expired">已过期</option>
                            <option value="Failed">失败</option>
                        </InputSelect>
                        <InputText class="px-3 py-2 rounded-md border border-input focus:outline-none focus:ring-2 focus:ring-ring bg-background text-foreground" @bind-Value="searchDomain" placeholder="搜索域名" @onkeyup="LoadCertificates" />
                    </div>
                </div>

                @if (certificates == null || certificates.Count == 0)
                {
                    <div class="text-center py-12 text-muted-foreground">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-muted-foreground mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <p>暂无证书</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var cert in certificates)
                        {
                            <div class="border border-border rounded-lg p-4 hover:shadow-md transition-shadow">
                                <div class="flex justify-between items-start mb-3">
                                    <div>
                                        <h3 class="font-semibold text-foreground">@cert.Domain</h3>
                                        @if (cert.IsWildcard)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary">泛域名</span>
                                        }
                                    </div>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @GetStatusClass(cert.Status)">
                                        @GetStatusText(cert.Status)
                                    </span>
                                </div>

                                <div class="space-y-2 text-sm text-muted-foreground mb-4">
                                    <div class="flex justify-between">
                                        <span>申请时间:</span>
                                        <span class="text-foreground">@cert.IssuedAt.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>过期时间:</span>
                                        <span class="text-foreground @GetExpiryClass(cert.ExpiresAt)">@cert.ExpiresAt.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>ACME状态:</span>
                                        <span class="text-foreground">@GetAcmeStatusText(cert.AcmeStatus)</span>
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <button class="btn-primary text-sm" @onclick="@(() => ShowExportDialog(cert))">导出</button>
                                    @if (cert.Status == CertificateStatus.Active)
                                    {
                                        <button class="btn-secondary text-sm" @onclick="@(() => RenewCertificate(cert.Id))">续签</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (showExportDialog)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="HideExportDialog">
        <div class="card max-w-md w-full" @onclick:stopPropagation>
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">导出证书</h3>
                <button class="text-muted-foreground hover:text-foreground" @onclick="HideExportDialog">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium mb-2">导出格式</label>
                <InputSelect class="w-full px-3 py-2 rounded-md border border-input focus:outline-none focus:ring-2 focus:ring-ring bg-background text-foreground" @bind-Value="exportFormat">
                    <option value="Pfx">PFX/P12</option>
                    <option value="Pem">PEM</option>
                    <option value="Crt">CRT/CER</option>
                </InputSelect>
            </div>

            @if (exportFormat == "Pfx")
            {
                <div class="mb-6">
                    <label class="block text-sm font-medium mb-2">密码（可选）</label>
                    <InputText class="w-full px-3 py-2 rounded-md border border-input focus:outline-none focus:ring-2 focus:ring-ring bg-background text-foreground" type="password" @bind-Value="exportPassword" placeholder="留空则不设置密码" />
                </div>
            }

            <div class="flex justify-end gap-3">
                <button class="btn-secondary" @onclick="HideExportDialog">取消</button>
                <button class="btn-primary" @onclick="ExportCertificate" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <span>导出中...</span>
                    }
                    else
                    {
                        <span>导出</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Certificate> certificates = new();
    private CertificateStatus? filterStatus;
    private string searchDomain = string.Empty;
    private bool isSubmitting = false;
    private bool showExportDialog = false;
    private bool isExporting = false;
    private Certificate? selectedCertificate;
    private string exportFormat = "Pfx";
    private string exportPassword = string.Empty;
    private bool useStaging = false;

    private class NewCertificateModel
    {
        public string Domain { get; set; } = string.Empty;
        public bool IsWildcard { get; set; }
    }

    private NewCertificateModel newCertificateModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificates();
    }

    private string GetStatusText(CertificateStatus status)
    {
        return status switch
        {
            CertificateStatus.Active => "有效",
            CertificateStatus.Pending => "待处理",
            CertificateStatus.Expiring => "即将过期",
            CertificateStatus.Expired => "已过期",
            CertificateStatus.Failed => "失败",
            _ => "未知"
        };
    }

    private string GetStatusClass(CertificateStatus status)
    {
        return status switch
        {
            CertificateStatus.Active => "bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200",
            CertificateStatus.Pending => "bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200",
            CertificateStatus.Expiring => "bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200",
            CertificateStatus.Expired => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200",
            CertificateStatus.Failed => "bg-gray-900 dark:bg-gray-800 text-white dark:text-gray-100",
            _ => "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200"
        };
    }

    private string GetExpiryClass(DateTime expiryDate)
    {
        var daysRemaining = (expiryDate - DateTime.UtcNow).Days;
        return daysRemaining switch
        {
            <= 0 => "text-destructive",
            <= 30 => "text-yellow-600 dark:text-yellow-400",
            _ => "text-foreground"
        };
    }

    private string GetAcmeStatusText(AcmeProcessStatus status)
    {
        return status switch
        {
            AcmeProcessStatus.Initializing => "初始化",
            AcmeProcessStatus.CreatingAccount => "创建账户",
            AcmeProcessStatus.CreatingOrder => "创建订单",
            AcmeProcessStatus.ProcessingAuthorization => "处理授权",
            AcmeProcessStatus.CreatingDnsRecord => "创建DNS记录",
            AcmeProcessStatus.WaitingDnsPropagation => "等待DNS传播",
            AcmeProcessStatus.ValidatingChallenge => "验证挑战",
            AcmeProcessStatus.GeneratingCertificate => "生成证书",
            AcmeProcessStatus.Completed => "已完成",
            AcmeProcessStatus.Failed => "失败",
            _ => "未知"
        };
    }

    private async Task LoadCertificates()
    {
        if (!string.IsNullOrEmpty(searchDomain))
        {
            certificates = await CertificateRepository.SearchByDomainAsync(searchDomain);
        }
        else if (filterStatus.HasValue)
        {
            certificates = await CertificateRepository.GetByStatusAsync(filterStatus.Value);
        }
        else
        {
            certificates = await CertificateRepository.GetAllAsync();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            var dnsProvider = await GetDefaultDnsProvider();
            await CertificateService.RequestCertificateAsync(
                newCertificateModel.Domain,
                newCertificateModel.IsWildcard,
                dnsProvider,
                useStaging);
            await LoadCertificates();
            newCertificateModel = new NewCertificateModel();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowExportDialog(Certificate certificate)
    {
        selectedCertificate = certificate;
        showExportDialog = true;
    }

    private void HideExportDialog()
    {
        showExportDialog = false;
        selectedCertificate = null;
        exportPassword = string.Empty;
    }

    private async Task ExportCertificate()
    {
        if (selectedCertificate == null) return;

        isExporting = true;
        try
        {
            var format = exportFormat switch
            {
                "Pfx" => CertificateFormat.Pfx,
                "Pem" => CertificateFormat.Pem,
                "Crt" => CertificateFormat.Crt,
                _ => CertificateFormat.Pfx
            };

            var url = $"/api/certificates/download/{selectedCertificate.Id}?format={format}";
            if (!string.IsNullOrEmpty(exportPassword))
            {
                url += $"&password={Uri.EscapeDataString(exportPassword)}";
            }

            var fileName = $"{selectedCertificate.Domain}.{format.ToString().ToLower()}";

            await JS.InvokeVoidAsync("downloadFile", new object[] { url, fileName });

            HideExportDialog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task RenewCertificate(Guid certificateId)
    {
        try
        {
            await CertificateService.RenewCertificateAsync(certificateId);
            await LoadCertificates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task<DnsProvider> GetDefaultDnsProvider()
    {
        return await Task.FromResult(new DnsProvider
        {
            Id = Guid.NewGuid(),
            ProviderType = DnsProviderType.Aliyun,
            AccessKeyId = string.Empty,
            AccessKeySecret = string.Empty,
            RegionId = "cn-hangzhou",
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        });
    }
}