@page "/certificates/apply"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MinGo.CertManager.Core.Entities
@using Microsoft.AspNetCore.Components.Forms
@using MinGo.CertManager.Infrastructure.Repositories
@using MinGo.CertManager.Infrastructure.Jobs
@using Quartz
@inject ICertificateRepository CertificateRepository
@inject ISchedulerFactory SchedulerFactory
@inject NavigationManager NavigationManager

<PageTitle>申请证书</PageTitle>

<div class="mb-8">
    <div class="flex items-center gap-4">
        <button class="btn btn-secondary" @onclick="NavigateToCertificates">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            返回列表
        </button>
    </div>
</div>

<div class="max-w-2xl">
    <div class="card">
        <div class="p-6 border-b border-border">
            <h1 class="text-2xl font-bold">申请新证书</h1>
            <p class="text-muted-foreground mt-1">填写以下信息申请SSL证书</p>
        </div>

        <div class="p-6">
            <EditForm Model="@applyModel" OnValidSubmit="HandleApply">
                <DataAnnotationsValidator />
                <div class="space-y-6">
                    <div>
                        <label class="label">域名</label>
                        <InputText class="input" @bind-Value="applyModel.Domain" placeholder="example.com" />
                        <div class="mt-2">
                            <InputCheckbox class="checkbox" @bind-Value="applyModel.IsWildcard" />
                            <label class="ml-2 text-sm">申请泛域名证书 (*.example.com)</label>
                        </div>
                    </div>

                    <div>
                        <label class="label">DNS提供商</label>
                        <InputSelect class="select" @bind-Value="applyModel.DnsProvider">
                            <option value="Aliyun">阿里云DNS</option>
                        </InputSelect>
                    </div>

                    <div>
                        <label class="label">邮箱地址（用于ACME账户）</label>
                        <InputText class="input" @bind-Value="applyModel.Email" placeholder="your-email@example.com" type="email" />
                    </div>

                    <div>
                        <label class="label">ACME环境</label>
                        <InputSelect class="select" @bind-Value="applyModel.UseStaging">
                            <option value="false">生产环境（Let's Encrypt）</option>
                            <option value="true">测试环境（Let's Encrypt Staging）</option>
                        </InputSelect>
                        <p class="text-sm text-muted-foreground mt-1">测试环境用于验证配置，不会产生真实证书，建议首次使用时选择测试环境</p>
                    </div>

                    <div class="flex justify-end gap-3 pt-4">
                        <button type="button" class="btn btn-secondary" @onclick="NavigateToCertificates">取消</button>
                        <button type="submit" class="btn btn-primary flex-1" disabled="@IsApplying">
                            @if (IsApplying)
                            {
                                <span>申请中...</span>
                            }
                            else
                            {
                                <span>申请证书</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>

            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="mt-4 p-4 rounded-md @(IsSuccess ? "bg-green-50 text-green-800" : "bg-red-50 text-red-800")">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            @if (IsSuccess)
                            {
                                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                            }
                            else
                            {
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                </svg>
                            }
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium">
                                @StatusMessage
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private class ApplyCertificateModel
    {
        public string Domain { get; set; } = string.Empty;
        public bool IsWildcard { get; set; }
        public string DnsProvider { get; set; } = "Aliyun";
        public string Email { get; set; } = string.Empty;
        public bool UseStaging { get; set; } = false;
    }

    private ApplyCertificateModel applyModel = new();
    private bool IsApplying { get; set; }
    private string? StatusMessage { get; set; }
    private bool IsSuccess { get; set; }

    private void NavigateToCertificates()
    {
        NavigationManager.NavigateTo("/certificates");
    }

    private async Task HandleApply()
    {
        try
        {
            IsApplying = true;
            StatusMessage = null;

            // 检查同一域名是否已有证书正在申请中
            var hasPending = await CertificateRepository.HasPendingCertificateAsync(applyModel.Domain, applyModel.IsWildcard);
            if (hasPending)
            {
                IsSuccess = false;
                StatusMessage = $"域名 {applyModel.Domain} 已有证书正在申请中，请稍后再试";
                return;
            }

            // 创建证书记录
            var certificate = new Certificate
            {
                Id = Guid.NewGuid(),
                Domain = applyModel.Domain,
                IsWildcard = applyModel.IsWildcard,
                UseStaging = applyModel.UseStaging,
                Status = CertificateStatus.Pending,
                AcmeStatus = AcmeProcessStatus.Initializing,
                AcmeStatusMessage = "等待处理",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            await CertificateRepository.AddAsync(certificate);

            // 触发一次性作业
            var scheduler = await SchedulerFactory.GetScheduler();
            var jobDetail = JobBuilder.Create<CertificateRequestJob>()
                .WithIdentity($"CertificateRequest-{certificate.Id}", "CertificateRequests")
                .WithDescription($"申请证书: {certificate.Domain}")
                .UsingJobData("CertificateId", certificate.Id)
                .Build();

            var trigger = TriggerBuilder.Create()
                .WithIdentity($"CertificateRequestTrigger-{certificate.Id}", "CertificateRequests")
                .StartNow()
                .Build();

            await scheduler.ScheduleJob(jobDetail, trigger);

            IsSuccess = true;
            StatusMessage = $"证书申请已提交！证书ID: {certificate.Id}。您可以在证书列表中查看申请进度。";
            
            // 3秒后跳转到证书列表
            await Task.Delay(3000);
            NavigationManager.NavigateTo("/certificates");
        }
        catch (Exception ex)
        {
            IsSuccess = false;
            StatusMessage = $"申请失败: {ex.Message}";
        }
        finally
        {
            IsApplying = false;
        }
    }
}
