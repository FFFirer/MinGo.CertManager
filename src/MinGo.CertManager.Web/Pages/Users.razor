@page "/users"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using MinGo.CertManager.Core.Entities
@using MinGo.CertManager.Infrastructure.Data
@using MinGo.CertManager.Web.Components
@using System.Linq

<PageHeader
    Title="用户管理"
    Description="管理系统用户">
    <Actions>
        <button class="btn btn-primary" @onclick="ShowAddUserDialog">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            添加用户
        </button>
    </Actions>
</PageHeader>

<div class="card">
    <DataTable TItem="ApplicationUser"
               Items="@users"
               RowActions="@UserRowActions"
               EmptyText="暂无用户"
               DetailTitle="用户详情">
        <DataTableColumn TItem="ApplicationUser" Header="用户名" IsIdentifying="true">
            <CellTemplate>
                <span class="font-medium">@context.UserName</span>
            </CellTemplate>
        </DataTableColumn>
        <DataTableColumn TItem="ApplicationUser" Header="角色">
            <CellTemplate>
                <span class="badge badge-info">@GetRoleText(context)</span>
            </CellTemplate>
        </DataTableColumn>
        <DataTableColumn TItem="ApplicationUser" Header="外部身份" VisibleOnMobile="false" Width="min-w-[120px]">
            <CellTemplate>
                @{
                    var logins = GetUserLogins(context.Id);
                }
                @if (logins.Count > 0)
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var login in logins)
                        {
                            <span class="badge @GetBadgeClass(login.LoginProvider)">@login.ProviderDisplayName</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted-foreground">—</span>
                }
            </CellTemplate>
        </DataTableColumn>
        <DataTableColumn TItem="ApplicationUser" Header="创建时间" VisibleOnMobile="false">
            <CellTemplate>
                @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </CellTemplate>
        </DataTableColumn>
    </DataTable>
</div>

<AddUserModal IsVisible="@showAddUserModal" OnClose="HideAddUserDialog" OnAdd="HandleAddUser" />

@code {
    [Inject]
    private UserManager<ApplicationUser> UserManager { get; set; } = null!;

    [Inject]
    private RoleManager<IdentityRole> RoleManager { get; set; } = null!;

    private List<ApplicationUser> users = new();
    private Dictionary<string, string> userRoles = new();
    private Dictionary<string, List<UserLoginInfo>> userLogins = new();
    private bool showAddUserModal = false;

    private RenderFragment<ApplicationUser> UserRowActions => user => builder =>
    {
        if (user.UserName != "admin")
        {
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "class", "btn btn-secondary");
            builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => DeleteUser(user.Id)));
            builder.AddContent(3, "删除");
            builder.CloseElement();
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = UserManager.Users.ToList();
        userRoles = new Dictionary<string, string>();
        userLogins = new Dictionary<string, List<UserLoginInfo>>();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            var roleName = roles.FirstOrDefault();
            userRoles[user.Id] = roleName switch
            {
                "Admin" => "管理员",
                "User" => "普通用户",
                _ => "未知"
            };

            var logins = await UserManager.GetLoginsAsync(user);
            userLogins[user.Id] = logins.ToList();
        }
    }

    private string GetRoleText(ApplicationUser user)
    {
        return userRoles.TryGetValue(user.Id, out var roleText) ? roleText : "未知";
    }

    private List<UserLoginInfo> GetUserLogins(string userId)
    {
        return userLogins.TryGetValue(userId, out var logins) ? logins : new();
    }

    private string GetBadgeClass(string providerName)
    {
        return providerName switch
        {
            "github" => "badge bg-[#24292f] text-white",
            "simpleidserver" => "badge bg-[#5c6bc0] text-white",
            "google" => "badge bg-[#4285f4] text-white",
            _ => "badge"
        };
    }

    private void ShowAddUserDialog()
    {
        showAddUserModal = true;
    }

    private void HideAddUserDialog()
    {
        showAddUserModal = false;
    }

    private async Task HandleAddUser(User user)
    {
        var newUser = new ApplicationUser
        {
            UserName = user.Username,
            Email = $"{user.Username}@example.com",
            EmailConfirmed = true,
            Status = UserStatus.Active,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };

        var result = await UserManager.CreateAsync(newUser, user.PasswordHash);
        if (result.Succeeded)
        {
            var roleName = user.Role == UserRole.Admin ? "Admin" : "User";
            await UserManager.AddToRoleAsync(newUser, roleName);
            await LoadUsers();
        }
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null && user.UserName != "admin")
        {
            await UserManager.DeleteAsync(user);
            await LoadUsers();
        }
    }
}
